NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_public_anon_key
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
SUPABASE_STORAGE_BUCKET=attachments
# For SQLite (dev): file:./prisma/dev.db
# For Postgres/Supabase (production): add connection pool params to avoid exhaustion:
# DATABASE_URL="postgresql://user:pass@host:5432/db?connection_limit=5&pool_timeout=10"
DATABASE_URL=file:./prisma/dev.db

# Use a unique random value of at least 32 characters.
AUTH_SESSION_SECRET=replace_with_a_long_random_secret

# Configure only the roles your deployment uses. Passwords are server-only.
SOLIDCORE_ADMIN_USERNAME=admin
SOLIDCORE_ADMIN_PASSWORD=replace_with_a_strong_unique_password
SOLIDCORE_ADMIN_NAME=SolidCore Owner
SOLIDCORE_SALES_USERNAME=sales
SOLIDCORE_SALES_PASSWORD=replace_with_a_strong_unique_password
SOLIDCORE_SALES_NAME=SolidCore Sales
SOLIDCORE_WAREHOUSE_USERNAME=warehouse
SOLIDCORE_WAREHOUSE_PASSWORD=replace_with_a_strong_unique_password
SOLIDCORE_WAREHOUSE_NAME=SolidCore Warehouse
